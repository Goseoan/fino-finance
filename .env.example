# Prefer the app's /connect page. Never prefix credentials with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional existing offline token; scope must include spreadsheets (read+write).
GOOGLE_REFRESH_TOKEN=
GOOGLE_SPREADSHEET_ID=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/google/callback

# Optional source workbook to protect from app writes.
GOOGLE_PROTECTED_SPREADSHEET_ID=
